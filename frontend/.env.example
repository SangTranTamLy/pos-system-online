# ============================================================
# Cấu hình VietQR động cho thanh toán QR tại quầy (TÙY CHỌN)
#
# Cách dùng:
# 1. Copy file này thành frontend/.env
# 2. Điền thông tin tài khoản nhận tiền bên dưới
# 3. Restart frontend (npm run dev)
#
# Nếu ĐỂ TRỐNG: hệ thống dùng ảnh QR tĩnh tại frontend/src/assets/qr.png
# (thay ảnh QR nhận tiền thật của bạn vào file đó).
#
# LƯU Ý: KHÔNG commit file .env lên Git.
# ============================================================

# Mã ngân hàng theo vietqr.io (ví dụ: mbbank, vcb, vietinbank, tpbank, acb...)
VITE_VIETQR_BANK_ID=

# Số tài khoản nhận tiền
VITE_VIETQR_ACCOUNT_NO=

# Tên chủ tài khoản (viết không dấu, ví dụ: TRAN THANH SANG)
VITE_VIETQR_ACCOUNT_NAME=
